<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <SailwindDir Condition="'$(SailwindDir)' == ''"
      >$(HOME)/.local/share/Steam/steamapps/common/Sailwind</SailwindDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../FishermanGeometry.cs" Link="FishermanGeometry.cs" />
    <Compile Include="../../FishermanOrderText.cs" Link="FishermanOrderText.cs" />
    <Compile Include="../../FlyingSailGeometry.cs" Link="FlyingSailGeometry.cs" />
    <Compile Include="../../FishermanTravel.cs" Link="FishermanTravel.cs" />
    <Compile Include="../../MastInstallationGeometry.cs" Link="MastInstallationGeometry.cs" />
    <Compile Include="../../FishermanBillow.cs" Link="FishermanBillow.cs" />
    <Compile Include="../../FishermanTension.cs" Link="FishermanTension.cs" />
    <Compile Include="../../FishermanAerodynamics.cs" Link="FishermanAerodynamics.cs" />
    <Compile Include="../../BoatRigs/*.cs" Link="BoatRigs/%(Filename)%(Extension)" />
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SailwindDir)/Sailwind_Data/Managed/UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.ClothModule">
      <HintPath>$(SailwindDir)/Sailwind_Data/Managed/UnityEngine.ClothModule.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
