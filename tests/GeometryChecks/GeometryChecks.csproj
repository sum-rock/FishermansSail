<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <SailwindDir Condition="'$(SailwindDir)' == ''"
      >$(HOME)/.local/share/Steam/steamapps/common/Sailwind</SailwindDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile
      Include="../../Stays/FishermansStay/FishermansStaySaveState.cs"
      Link="FishermansStay/FishermansStaySaveState.cs"
    />
    <None Update="FishermansStay/StayMeasurements.txt" CopyToOutputDirectory="PreserveNewest" />
    <Compile
      Include="../../Stays/FishermansStay/FishermansStayGeometry.cs"
      Link="FishermansStay/FishermansStayGeometry.cs"
    />
    <Compile
      Include="../../Stays/FishermansStay/FishermansStayOrderText.cs"
      Link="FishermansStay/FishermansStayOrderText.cs"
    />
    <Compile
      Include="../../Sails/FishermansFlyingSail/FishermansFlyingSailGeometry.cs"
      Link="FishermansFlyingSail/FishermansFlyingSailGeometry.cs"
    />
    <Compile
      Include="../../Sails/FishermansFlyingSail/FishermansFlyingSailOrderText.cs"
      Link="FishermansFlyingSail/FishermansFlyingSailOrderText.cs"
    />
    <Compile
      Include="../../Sails/FishermansFlyingSail/FishermansFlyingSailFrameGeometry.cs"
      Link="FishermansFlyingSail/FishermansFlyingSailFrameGeometry.cs"
    />
    <Compile
      Include="../../Sails/FishermansFlyingSail/FishermansFlyingSailTravel.cs"
      Link="FishermansFlyingSail/FishermansFlyingSailTravel.cs"
    />
    <Compile
      Include="../../Sails/FishermansFlyingSail/FishermansFlyingSailMastInstallationGeometry.cs"
      Link="FishermansFlyingSail/FishermansFlyingSailMastInstallationGeometry.cs"
    />
    <Compile
      Include="../../Sails/FishermansFlyingSail/FishermansFlyingSailBillow.cs"
      Link="FishermansFlyingSail/FishermansFlyingSailBillow.cs"
    />
    <Compile
      Include="../../Sails/FishermansFlyingSail/FishermansFlyingSailTension.cs"
      Link="FishermansFlyingSail/FishermansFlyingSailTension.cs"
    />
    <Compile
      Include="../../Sails/FishermansFlyingSail/FishermansFlyingSailAerodynamics.cs"
      Link="FishermansFlyingSail/FishermansFlyingSailAerodynamics.cs"
    />
    <Compile
      Include="../../BoatRigs/**/*.cs"
      Link="BoatRigs/%(RecursiveDir)%(Filename)%(Extension)"
    />
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SailwindDir)/Sailwind_Data/Managed/UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.ClothModule">
      <HintPath>$(SailwindDir)/Sailwind_Data/Managed/UnityEngine.ClothModule.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
